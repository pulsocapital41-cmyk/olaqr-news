---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import { getNotas, SECTIONS, slugify, cats, img, summary, fmt, optimize } from '../lib';
const notas = await getNotas();
const hero = notas[0];
const side = notas.slice(1, 4);
const grid = notas.slice(4, 10);
const latest = notas.slice(10, 20);
const blocks = SECTIONS.slice(0, 4).map((s) => ({
  name: s,
  items: notas.filter((n) => cats(n).some((c) => slugify(c) === slugify(s))).slice(0, 4),
}));
---
<Base>
  <section class="wrap hero">
    <a href={`/nota/${hero.id}/`} class="hero-main">
      <img src={optimize(img(hero), 1400)} alt={hero.data.title} fetchpriority="high" />
      <div class="hero-txt">
        <span class="tag tag-light">{cats(hero)[0]}</span>
        <h1>{hero.data.title}</h1>
        <p>{summary(hero)}</p>
        <time>{fmt(hero.data.pubDate)}</time>
      </div>
    </a>
    <aside class="hero-side">
      <h2 class="kicker">Lo último</h2>
      {side.map((n) => <Card nota={n} size="sm" />)}
    </aside>
  </section>

  <section class="wrap">
    <h2 class="sec-title"><span>Destacadas</span></h2>
    <div class="grid3">{grid.map((n) => <Card nota={n} />)}</div>
  </section>

  {blocks.map((b) => (
    <section class="wrap">
      <h2 class="sec-title"><span>{b.name}</span><a href={`/seccion/${slugify(b.name)}/`}>Ver todo →</a></h2>
      <div class="grid4">{b.items.map((n) => <Card nota={n} size="md" />)}</div>
    </section>
  ))}

  <section class="wrap">
    <h2 class="sec-title"><span>Más noticias</span></h2>
    <div class="grid3">{latest.map((n) => <Card nota={n} />)}</div>
  </section>
</Base>
